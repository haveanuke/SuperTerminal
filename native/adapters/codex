#!/bin/sh
# SuperTerminal adapter: run the real codex with a notify hook that rings the
# terminal bell on turn-complete, so the app's audio cue fires. Resolution
# uses ST_ORIG_PATH (the PATH before this shim dir was prepended) so the
# adapter can never find itself. A user-supplied notify override passes
# through untouched.
real="$(PATH="${ST_ORIG_PATH:-$PATH}" command -v codex)" || {
    echo "superterminal adapter: codex not found on PATH" >&2
    exit 127
}
[ "$real" = "$0" ] && {
    echo "superterminal adapter: refusing to recurse into itself" >&2
    exit 127
}
for arg in "$@"; do
    case "$arg" in
        notify=*|--config=notify=*) exec "$real" "$@" ;;
    esac
done
helper="$(cd "$(dirname "$0")" && pwd)/st-bell"
exec "$real" -c "notify=[\"$helper\"]" "$@"
