{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SuperTerminal",
  "version": "0.3.3",
  "identifier": "com.tomaspinal.superterminal",
  "build": {
    "beforeDevCommand": "npx vite",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npx vite build",
    "frontendDist": "../dist/renderer"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/background/*"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/icon.icns"
    ],
    "category": "DeveloperTool",
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  }
}
